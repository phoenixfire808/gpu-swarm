# Private Discord GPU/CPU Co-op Swarm
# Copy to .env and fill in values. Never commit .env.

# Scheduler
GPU_SWARM_HOST=127.0.0.1
# Use 8766 on Drew's PC (8765 is Robinhood Command Center)
GPU_SWARM_PORT=8766
GPU_SWARM_DB=data/swarm.db
# Set to 0.0.0.0 only on trusted LAN/Tailscale
# GPU_SWARM_HOST=0.0.0.0

# Worker / utilizer client defaults
# Local host scripts: http://127.0.0.1:8766
# Tailscale members / SDK default: http://100.85.165.84:8766
GPU_SWARM_SCHEDULER_URL=http://127.0.0.1:8766
GPU_SWARM_WORKER_NAME=
GPU_SWARM_MAX_VRAM_MB=0
GPU_SWARM_MAX_CPU_PERCENT=50
GPU_SWARM_MAX_RAM_MB=0
GPU_SWARM_MAX_DISK_MB=0
# Desktop joiner may set GB instead; worker converts to MB
# GPU_SWARM_MAX_DISK_GB=0
# Portal aliases (optional):
# GPU_SWARM_DEDICATED_RAM_MB=0
# GPU_SWARM_DEDICATED_DISK_MB=0
# GPU_SWARM_DEDICATED_CPU_CORES=0
GPU_SWARM_DISCORD_USER=
# Optional: drive free-space is measured on this path (default = project root)
# GPU_SWARM_WORK_DIR=
GPU_SWARM_HEARTBEAT_SEC=10
GPU_SWARM_POLL_SEC=2
GPU_SWARM_DEDICATED_CPU_CORES=0
GPU_SWARM_CONTRIBUTOR_NAME=
GPU_SWARM_START_TOKEN=
GPU_SWARM_PORTAL_URL=http://127.0.0.1:8767

# Web contributor portal (browser UI on :8767) — MVP auth; OAuth later
GPU_SWARM_PORTAL_HOST=127.0.0.1
GPU_SWARM_PORTAL_PORT=8767
GPU_SWARM_PORTAL_DB=data/portal.db
GPU_SWARM_POOL_PASSWORD=changeme-coop
# Comma-separated invite codes (optional alternative to pool password)
GPU_SWARM_INVITE_CODES=
# Optional public URL in worker instructions (Tailscale etc.)
# GPU_SWARM_PORTAL_PUBLIC_URL=http://100.85.165.84:8767

# Discord bot — dedicated app **GPU Pool** (NOT Hermes Jarvis). Never invent a token.
# Discord Developer Portal: https://discord.com/developers/applications → GPU Pool (client id 1534226262510403654)
# Enable Message Content Intent on the Bot page (required by gpu_swarm/bot.py).
# Invite: make-invite-url.cmd <CLIENT_ID>  (scopes bot + applications.commands, perms 84992)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=1534226262510403654
# Guild for fast slash sync (Glitch Factor = 1532614467974856724; Jarvis HQ = 1532553474577924156)
DISCORD_GUILD_ID=
